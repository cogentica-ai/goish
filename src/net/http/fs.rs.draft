    w.Header().Set(string("Accept-Ranges"), string("bytes"));
    if len(&ranges) > 0 || w.Header().Get(string("Content-Encoding")) == "" {
        w.Header().Set(string("Content-Length"), strconv::FormatInt(sendSize, 10));
    }
