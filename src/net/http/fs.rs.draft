// go: sdk 1.25.5 net/http/fs.go:139-178 dirList
// go: draft goishc — machine-translated, unreviewed
pub fn dirList(w: impl ResponseWriter + 'static, r: nilable![&http::Request], f: impl File + 'static) {
    let mut dirs: alloc::sync::Arc<dyn anyDirs + Send + Sync> = Default::default();
    let mut err: error = Default::default();
    {
        let (mut d, ok) = f.As::<dyn fs::ReadDirFile + Send + Sync>();
        if ok {
            let mut list: dirEntryDirs = Default::default();
            (list, err) = d.ReadDir(-1);
            dirs = alloc::sync::Arc::new(list);
        } else {
            let mut list: fileInfoDirs = Default::default();
            (list, err) = f.Readdir(-1);
            dirs = alloc::sync::Arc::new(list);
        }
    }
    if err != nil {
        logf(r, string("http: error reading directory: %v"), goish::Any::new(err));
        Error(w, string("Error reading directory"), StatusInternalServerError);
        return;
    }
    sort::Slice(&mut dirs, move |i: int, j: int| dirs.name(i) < dirs.name(j));
    w.Header().Set(string("Content-Type"), string("text/html; charset=utf-8"));
    fmt::Fprintf!(&mut w, string("<!doctype html>\n"));
    fmt::Fprintf!(&mut w, string("<meta name=\"viewport\" content=\"width=device-width\">\n"));
    fmt::Fprintf!(&mut w, string("<pre>\n"));
    {
        let (mut i, n): (int, _) = (0, dirs.len());
        while i < n {
            let mut name = dirs.name(i);
            if dirs.isDir(i) {
                name += string("/");
            }
            let url = url::URL { Path: name.clone(), ..Default::default() };
            fmt::Fprintf!(&mut w, string("<a href=\"%s\">%s</a>\n"), url::String(), htmlReplacer.Must().Replace(name));
            i = i.wrapping_add(1);
        }
    }
    fmt::Fprintf!(&mut w, string("</pre>\n"));
}

