// go: sdk 1.25.5 net/http/fs.go:49-68 mapOpenError
// go: draft goishc — machine-translated, unreviewed
pub fn mapOpenError<S: Into<string>>(originalErr: error, name: S, sep: rune, stat: alloc::sync::Arc<dyn Fn(string) -> (alloc::sync::Arc<dyn fs::FileInfo + Send + Sync>, error) + Send + Sync>) -> error {
    let name = name.into();
    if errors::Is(originalErr.clone(), fs::ErrNotExist) || errors::Is(originalErr.clone(), fs::ErrPermission) {
        return originalErr;
    }
    let parts = strings::Split(name, goish::string::from_rune(sep));
    for (i, _) in range!(parts) {
        if parts[i] == "" {
            continue;
        }
        let (mut fi, err) = stat(strings::Join(parts.slice(0, i.wrapping_add(1)), goish::string::from_rune(sep)));
        if err != nil {
            return originalErr;
        }
        if !fi.IsDir() {
            return fs::ErrNotExist;
        }
    }
    return originalErr;
}

goish::var! {
    /// errInvalidUnsafePath is returned by Dir.Open when the call to
    /// filepath.Localize fails. filepath.Localize returns an error if the path
    /// cannot be represented by the operating system.
    pub errInvalidUnsafePath: error = "http: invalid or unsafe file path";
}

impl Dir {
    // go: sdk 1.25.5 net/http/fs.go:77-96 Dir.Open
    // go: draft goishc — machine-translated, unreviewed
    pub fn Open<S: Into<string>>(&self, name: S) -> (alloc::sync::Arc<dyn File + Send + Sync>, error) {
        let name = name.into();
        let mut path = path::Clean(string("/") + name.clone()).slice(1, len(&path::Clean(string("/") + name)));
        if path == "" {
            path = string(".");
        }
        let (mut path, err) = filepath::Localize(path);
        if err != nil {
            return (nil.into(), errInvalidUnsafePath.into());
        }
        let mut dir = self.0.clone();
        if dir == "" {
            dir = string(".");
        }
        let fullName = filepath::Join(slice!([]string{dir, path}));
        let (f, err) = os::Open(fullName.clone());
        if err != nil {
            return (nil.into(), mapOpenError(err, fullName, filepath::Separator, (alloc::sync::Arc::new(os::Stat) as alloc::sync::Arc<dyn Fn(string) -> (alloc::sync::Arc<dyn fs::FileInfo + Send + Sync>, error) + Send + Sync>)));
        }
        return (f, nil.into());
    }
}





