    if size < 0 {
        serveError(w, string("negative content size computed"), StatusInternalServerError);
        return;
    }
    let mut sendSize = size;
    let mut sendContent: alloc::sync::Arc<dyn io::Reader + Send + Sync> = content.clone();
    let (mut ranges, err) = parseRange(rangeReq, size);
    if err == nil {
    } else if err == errNoOverlap {
