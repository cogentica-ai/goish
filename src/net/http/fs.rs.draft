// go: sdk 1.25.5 net/http/fs.go:679-762 serveFile
// go: draft goishc — machine-translated, unreviewed
pub fn serveFile<S: Into<string>>(w: impl ResponseWriter + 'static, r: nilable![&http::Request], fs: impl FileSystem + 'static, name: S, redirect: bool) {
    let name = name.into();
    let indexPage = string("/index.html");
    if strings::HasSuffix(r.Must().URL.Path, indexPage.clone()) {
        localRedirect(w, r, string("./"));
        return;
    }
    let (mut f, err) = fs::Open(name.clone());
    if err != nil {
        let (msg, code) = toHTTPError(err);
        serveError(w, msg, code);
        return;
    }
    /* TODO(goishc): stmt *ast.DeferStmt */;
    let (mut d, err) = f.Stat();
    if err != nil {
        let (msg, code) = toHTTPError(err);
        serveError(w, msg, code);
        return;
    }
    if redirect {
        let url = r.Must().URL.Path.clone();
        if d.IsDir() {
            if url[len(&url).wrapping_sub(1)] != 47 /*'/'*/ {
                localRedirect(w, r, path::Base(url) + string("/"));
                return;
            }
        } else if url[len(&url).wrapping_sub(1)] == 47 /*'/'*/ {
            let base = path::Base(url);
            if base == "/" || base == "." {
                let msg = string("http: attempting to traverse a non-directory");
                serveError(w, msg, StatusInternalServerError);
                return;
            }
            localRedirect(w, r, string("../") + base);
            return;
        }
    }
    if d.IsDir() {
        let url = r.Must().URL.Path.clone();
        if url == "" || url[len(&url).wrapping_sub(1)] != 47 /*'/'*/ {
            localRedirect(w, r, path::Base(url) + string("/"));
            return;
        }
        let index = strings::TrimSuffix(name, string("/")) + indexPage;
        let (ff, err) = fs::Open(index);
        if err == nil {
            /* TODO(goishc): stmt *ast.DeferStmt */;
            let (dd, err) = ff.Stat();
            if err == nil {
                d = dd;
                f = ff;
            }
        }
    }
    if d.IsDir() {
        if checkIfModifiedSince(r, d.ModTime()) == condFalse {
            writeNotModified(w);
            return;
        }
        setLastModified(w, d.ModTime());
        dirList(w, r, f);
        return;
    }
    let mut sizeFunc = move || {
    return (d.Size(), nil);
};
    serveContent(w, r, d.Name(), d.ModTime(), sizeFunc, f);
}

// go: sdk 1.25.5 net/http/fs.go:769-781 toHTTPError
// go: draft goishc — machine-translated, unreviewed
pub fn toHTTPError(err: error) -> (string, int) {
    if errors::Is(err.clone(), fs::ErrNotExist) {
        return (string("404 page not found"), StatusNotFound);
    }
    if errors::Is(err.clone(), fs::ErrPermission) {
        return (string("403 Forbidden"), StatusForbidden);
    }
    if errors::Is(err, errInvalidUnsafePath.clone()) {
        return (string("404 page not found"), StatusNotFound);
    }
    return (string("500 Internal Server Error"), StatusInternalServerError);
}


// go: sdk 1.25.5 net/http/fs.go:814-826 ServeFile
// go: draft goishc — machine-translated, unreviewed
pub fn ServeFile<S: Into<string>>(w: impl ResponseWriter + 'static, r: nilable![&http::Request], name: S) {
    let name = name.into();
    if containsDotDot(r.Must().URL.Path) {
        serveError(w, string("invalid URL path"), StatusBadRequest);
        return;
    }
    let (dir, file) = filepath::Split(name);
    serveFile(w, r, Dir(dir), file, false);
}

