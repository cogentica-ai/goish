// go: sdk 1.25.5 net/http/fs.go:861-871 containsDotDot
// go: draft goishc — machine-translated, unreviewed
pub fn containsDotDot<S: Into<string>>(v: S) -> bool {
    let v = v.into();
    if !strings::Contains(v, string("..")) {
        return false;
    }
    for (ent, _) in range!(strings::FieldsFuncSeq(v, isSlashRune)) {
        if ent == ".." {
            return true;
        }
    }
    return false;
}



