    } else if len(&ranges) > 1 {
        sendSize = rangesMIMESize(ranges.clone(), ctype, size);
        code = StatusPartialContent;
        let (mut pr, mut pw) = io::Pipe();
        let mut mw = multipart::NewWriter(pw);
        w.Header().Set(string("Content-Type"), string("multipart/byteranges; boundary=") + mw.MustMut().Boundary());
        sendContent = pr;
        /* TODO(goishc): stmt *ast.DeferStmt */;
        /* TODO(goishc): stmt *ast.GoStmt */;
